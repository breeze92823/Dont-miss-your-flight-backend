# Copy to .env (gitignored) for local development. None of these are
# required to run `npm start` -- every one degrades gracefully when unset.

# MongoDB connection string for player-progress persistence. Bloxity Legion
# hosting injects this per game+channel in deployed environments; leave unset
# locally to run with persistence disabled (progress lasts the connection only).
MONGODB_URI=

# CORS allow-origin for deployed environments. Falls back to "*" when unset.
CLIENT_ORIGIN=

# HTTP port. Falls back to 2567 when unset.
PORT=2567

# --- Bloxity (injected by Bloxity hosting; leave unset locally) ---------------------------------------
# BLOXITY_ENV marks a hosted server: client-sent user ids are then never trusted, only verified tokens.
BLOXITY_ENV=
# API used to verify game tokens and rewarded-ad tokens, and to report leaderboards / stats.
BLOXITY_API_URL=
# Game id (= the client's GAME_SLUG, dont-miss-your-flight) and the token for leaderboard / stats /
# Open Rooms reports. Reports are skipped while either is unset.
BLOXITY_GAME_ID=
BLOXITY_REPORT_TOKEN=
# Open Rooms: where this pod reports its rooms every 2 s (roomReporter.ts), and this pod's name.
MATCHMAKER_REPORT_URL=
POD_NAME=
